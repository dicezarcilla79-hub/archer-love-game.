
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Archer Love Game</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #100d14;
    color: white;
    font-family: Arial, sans-serif;
}

.game {
    width: min(95vw, 700px);
    text-align: center;
}

h1 {
    font-size: clamp(28px, 5vw, 40px);
    font-style: italic;
    margin-bottom: 20px;
}

#arena {
    position: relative;
    width: 100%;
    height: 380px;
    overflow: hidden;
    background: linear-gradient(
        to bottom,
        #1b1035,
        #54285c,
        #773753
    );
    border: 1px solid #24142e;
    cursor: crosshair;
}

#stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
}

.star {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #fff1bb;
    box-shadow: 0 0 6px #fff;
}

.moon {
    position: absolute;
    top: 20px;
    left: 42%;
    width: 20px;
    height: 20px;
    background: #f4dcb4;
    border-radius: 50%;
    box-shadow: 0 0 18px #f4dcb455;
}

.hud {
    position: absolute;
    top: 15px;
    left: 15px;
    z-index: 5;
    color: #f6d66a;
    text-align: left;
    font-family: monospace;
    line-height: 1.7;
}

.love {
    position: absolute;
    top: 75px;
    width: 100%;
    color: #ff572e;
    font-size: clamp(32px, 8vw, 58px);
    font-weight: 900;
    letter-spacing: 4px;
    transform: rotate(-3deg);
    pointer-events: none;
}

#bow {
    position: absolute;
    left: 25px;
    top: 150px;
    width: 65px;
    height: 110px;
    z-index: 3;
}

#bow svg {
    width: 100%;
    height: 100%;
    overflow: visible;
}

#arrow {
    position: absolute;
    left: 70px;
    top: 195px;
    width: 70px;
    height: 4px;
    background: #d9e9f6;
    transform-origin: left center;
    z-index: 4;
    display: none;
}

#arrow::after {
    content: "";
    position: absolute;
    right: -1px;
    top: -5px;
    border-left: 12px solid #ffcc83;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
}

#target {
    --target-scale: 1;
    position: absolute;
    right: 25px;
    top: 150px;
    width: 65px;
    height: 65px;
    border-radius: 50%;
    transform: scale(var(--target-scale));
    background: #fff8e8;
    border: 3px solid #ffb7a2;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    box-shadow: 0 0 15px #ff8b6844;
}

.target-ring {
    width: 78%;
    height: 78%;
    border-radius: 50%;
    border: 5px solid #ff663e;
    display: flex;
    align-items: center;
    justify-content: center;
}

.target-center {
    width: 45%;
    height: 45%;
    border-radius: 50%;
    background: #e84a2b;
    border: 3px solid white;
}

#message {
    position: absolute;
    top: 45%;
    left: 0;
    width: 100%;
    text-align: center;
    color: #fff5bb;
    font-size: 22px;
    font-weight: bold;
    text-shadow: 0 2px 8px #000;
    pointer-events: none;
}

.controls {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin-top: 18px;
    flex-wrap: wrap;
}

button {
    padding: 12px 20px;
    border: none;
    border-radius: 8px;
    color: white;
    background: #e94d39;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #ff704f;
}

.hint {
    color: #aaa;
    font-size: 13px;
    line-height: 1.6;
    margin-top: 14px;
}

@media (max-width: 480px) {
    #arena {
        height: 330px;
    }

    #target {
        right: 20px;
    }

    #bow {
        left: 12px;
    }
}
</style>
</head>

<body>
<div class="game">
    <h1>Archer Love Game</h1>

    <div id="arena">
        <div id="stars"></div>
        <div class="moon"></div>

        <div class="hud">
            Score: <span id="score">0</span><br>
            High Score: <span id="high">0</span><br>
            Time: <span id="time">49</span>s
        </div>

        <div class="love">LOVE YOU ♥</div>

        <div id="bow">
            <svg viewBox="0 0 65 110">
                <path d="M 20 5 Q 62 55 20 105"
                      fill="none"
                      stroke="#48b9e7"
                      stroke-width="3"/>
                <path d="M 20 5 L 25 55 L 20 105"
                      fill="none"
                      stroke="#c6d8ed"
                      stroke-width="1.5"/>
                <path d="M 20 5 L 20 105"
                      fill="none"
                      stroke="#fff"
                      stroke-width="1"/>
            </svg>
        </div>

        <div id="arrow"></div>

        <div id="target">
            <div class="target-ring">
                <div class="target-center"></div>
            </div>
        </div>

        <div id="message"></div>
    </div>

    <div class="controls">
        <button id="shoot">Shoot Arrow ♥</button>
        <button id="restart">Restart Game</button>
    </div>

    <p class="hint">
        Click or tap the game area to aim. Press SPACE or tap
        Shoot Arrow to fire. Hit the target to earn points!
    </p>
</div>

<script>
const arena = document.getElementById("arena");
const bow = document.getElementById("bow");
const arrow = document.getElementById("arrow");
const target = document.getElementById("target");
const scoreDisplay = document.getElementById("score");
const highDisplay = document.getElementById("high");
const timeDisplay = document.getElementById("time");
const message = document.getElementById("message");
const shootButton = document.getElementById("shoot");
const restartButton = document.getElementById("restart");

let score = 0;
let time = 49;
let angle = 0;
let playing = true;
let shooting = false;
let timer;

let highScore = Number(
    localStorage.getItem("archerLoveHigh") || 0
);

highDisplay.textContent = highScore;

// Create the stars.
const stars = document.getElementById("stars");

for (let i = 0; i < 65; i++) {
    const star = document.createElement("span");
    star.className = "star";
    star.style.left = Math.random() * 100 + "%";
    star.style.top = Math.random() * 100 + "%";
    star.style.opacity = 0.3 + Math.random() * 0.7;
    stars.appendChild(star);
}

function aim(event) {
    if (!playing || shooting) return;

    const rect = arena.getBoundingClientRect();
    const x = event.clientX - rect.left;
    const y = event.clientY - rect.top;

    const bowX = bow.offsetLeft + bow.offsetWidth / 2;
    const bowY = bow.offsetTop + bow.offsetHeight / 2;

    angle = Math.atan2(y - bowY, x - bowX);

    // Keep the bow aimed toward the target.
    bow.style.transform =
        `rotate(${angle * 180 / Math.PI}deg)`;

    arrow.style.display = "block";
    arrow.style.left = bowX + "px";
    arrow.style.top = bowY + "px";
    arrow.style.transform =
        `rotate(${angle}rad)`;
}

arena.addEventListener("pointermove", aim);

function shoot() {
    if (!playing || shooting) return;

    shooting = true;
    message.textContent = "";

    const rect = arena.getBoundingClientRect();

    const startX = bow.offsetLeft + bow.offsetWidth / 2;
    const startY = bow.offsetTop + bow.offsetHeight / 2;

    const targetX =
        target.offsetLeft + target.offsetWidth / 2;
    const targetY =
        target.offsetTop + target.offsetHeight / 2;

    const dx = targetX - startX;
    const dy = targetY - startY;

    const distance = Math.hypot(dx, dy);
    const shotAngle = Math.atan2(dy, dx);

    arrow.style.display = "block";
    arrow.style.left = startX + "px";
    arrow.style.top = startY + "px";
    arrow.style.width = distance + "px";
    arrow.style.transform = `rotate(${shotAngle}rad)`;

    const hit = Math.abs(dy) < 45;

    setTimeout(() => {
        if (!playing) {
            shooting = false;
            return;
        }

        if (hit) {
            score += 100;
            scoreDisplay.textContent = score;

            message.textContent = "LOVE HIT! +100 ♥";

            if (score > highScore) {
                highScore = score;
                highDisplay.textContent = highScore;

                localStorage.setItem(
                    "archerLoveHigh",
                    highScore
                );
            }

            // Move the target to a new position.
            target.style.top =
                (70 + Math.random() *
                (rect.height - 140)) + "px";

            target.style.setProperty(
                "--target-scale",
                0.8 + Math.random() * 0.5
            );
        } else {
            message.textContent = "MISS! Try again ♥";
        }

        arrow.style.display = "none";
        shooting = false;
    }, 350);
}

shootButton.addEventListener("click", shoot);

arena.addEventListener("click", event => {
    if (event.target.closest("button")) return;
    if (!shooting) aim(event);
});

document.addEventListener("keydown", event => {
    if (event.code === "Space") {
        event.preventDefault();
        shoot();
    }
});

function startTimer() {
    clearInterval(timer);

    timer = setInterval(() => {
        if (!playing) return;

        time--;
        timeDisplay.textContent = time;

        if (time <= 0) {
            playing = false;
            clearInterval(timer);
            message.textContent =
                `GAME OVER! Final score: ${score}`;
        }
    }, 1000);
}

function restart() {
    clearInterval(timer);

    score = 0;
    time = 49;
    angle = 0;
    playing = true;
    shooting = false;

    scoreDisplay.textContent = score;
    timeDisplay.textContent = time;
    message.textContent = "";

    arrow.style.display = "none";
    bow.style.transform = "none";

    target.style.top = "150px";
    target.style.setProperty("--target-scale", 1);

    startTimer();
}

restartButton.addEventListener("click", restart);

startTimer();
</script>
</body>
</html>
